# --- Optional: free vision-LLM via OpenRouter (no paid keys needed; free-tier models only) ---
# Create a free key at https://openrouter.ai/keys . Without it, the app uses local Tesseract OCR + rules.
OPENROUTER_API_KEY=
# Comma-separated, tried in order. Free model IDs rotate - check https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=openrouter/free

# --- App ---
DB_PATH=data/receipts.db
MAX_UPLOAD_MB=10
# Ambiguous dates like 02/03/2026: false = MM/DD (US), true = DD/MM
DATE_DAYFIRST=false
